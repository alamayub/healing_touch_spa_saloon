rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything not explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Primitives & Identity Helpers
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'alamayub000@gmail.com' ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        )
      );
    }

    function isValidNonEmptyString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'active', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'active', 'createdAt'])
        && isValidId(data.uid)
        && isValidNonEmptyString(data.email, 5, 160)
        && isValidOptionalString(data, 'displayName', 120)
        && data.role in ['super_admin', 'manager', 'receptionist', 'therapist', 'stylist']
        && data.active is bool;
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'preferredLanguage', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == uid
        && isValidNonEmptyString(data.email, 5, 160)
        && isValidOptionalString(data, 'displayName', 120)
        && isValidOptionalString(data, 'phone', 24)
        && (!( 'preferredLanguage' in data ) || data.preferredLanguage in ['en', 'ne']);
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'id', 'bookingRef', 'category', 'serviceNames', 'date', 'startTime',
          'endTime', 'durationMinutes', 'totalNpr', 'customerName', 'customerPhone',
          'consentAccepted', 'agePolicyConfirmed', 'status', 'paymentMethod',
          'paymentStatus', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'bookingRef', 'userId', 'category', 'serviceIds', 'serviceNames',
          'isCouple', 'guestCount', 'staffId', 'staffName', 'roomId', 'roomName',
          'date', 'startTime', 'endTime', 'durationMinutes', 'bufferMinutes',
          'totalNpr', 'customerName', 'customerPhone', 'customerEmail',
          'preferredLanguage', 'notes', 'comfortPreferences', 'consentAccepted',
          'agePolicyConfirmed', 'status', 'paymentMethod', 'paymentStatus',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidNonEmptyString(data.bookingRef, 4, 32)
        && isValidOptionalString(data, 'userId', 128)
        && data.category in ['spa', 'salon', 'package']
        && data.serviceNames is list && data.serviceNames.size() >= 1 && data.serviceNames.size() <= 15
        && data.serviceNames[0] is string && data.serviceNames[0].size() <= 160
        && (!( 'serviceIds' in data ) || (data.serviceIds is list && data.serviceIds.size() <= 15))
        && (!( 'isCouple' in data ) || data.isCouple is bool)
        && (!( 'guestCount' in data ) || (data.guestCount is number && data.guestCount >= 1 && data.guestCount <= 4))
        && isValidOptionalString(data, 'staffId', 128)
        && isValidOptionalString(data, 'staffName', 120)
        && isValidOptionalString(data, 'roomId', 128)
        && isValidOptionalString(data, 'roomName', 120)
        && isValidNonEmptyString(data.date, 10, 12)
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidNonEmptyString(data.startTime, 4, 10)
        && isValidNonEmptyString(data.endTime, 4, 10)
        && data.durationMinutes is number && data.durationMinutes >= 10 && data.durationMinutes <= 600
        && (!( 'bufferMinutes' in data ) || (data.bufferMinutes is number && data.bufferMinutes >= 0 && data.bufferMinutes <= 120))
        && data.totalNpr is number && data.totalNpr >= 0 && data.totalNpr <= 500000
        && isValidNonEmptyString(data.customerName, 2, 120)
        && isValidNonEmptyString(data.customerPhone, 7, 24)
        && isValidOptionalString(data, 'customerEmail', 160)
        && (!( 'preferredLanguage' in data ) || data.preferredLanguage in ['en', 'ne'])
        && isValidOptionalString(data, 'notes', 600)
        && isValidOptionalString(data, 'comfortPreferences', 400)
        && data.consentAccepted == true
        && data.agePolicyConfirmed == true
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled', 'rejected', 'no_show']
        && data.paymentMethod in ['cash', 'esewa', 'khalti', 'fonepay']
        && data.paymentStatus in ['pending', 'advance_paid', 'paid', 'refunded', 'failed'];
    }

    function isValidBookingSlot(data) {
      return data.keys().hasAll(['id', 'bookingId', 'date', 'startTime', 'endTime', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'bookingId', 'date', 'startTime', 'endTime', 'staffId', 'roomId', 'status', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.bookingId)
        && isValidNonEmptyString(data.date, 10, 12)
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidNonEmptyString(data.startTime, 4, 10)
        && isValidNonEmptyString(data.endTime, 4, 10)
        && isValidOptionalString(data, 'staffId', 128)
        && isValidOptionalString(data, 'roomId', 128)
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled', 'rejected', 'no_show'];
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'authorName', 'serviceUsed', 'rating', 'comment', 'published', 'createdAt'])
        && data.keys().hasOnly(['id', 'authorName', 'serviceUsed', 'rating', 'comment', 'userId', 'isDemo', 'published', 'createdAt'])
        && isValidId(data.id)
        && isValidNonEmptyString(data.authorName, 2, 100)
        && isValidNonEmptyString(data.serviceUsed, 2, 120)
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && isValidNonEmptyString(data.comment, 5, 800)
        && isValidOptionalString(data, 'userId', 128)
        && (!( 'isDemo' in data ) || data.isDemo is bool)
        && data.published is bool;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'phone', 'email', 'subject', 'message', 'status', 'createdAt'])
        && isValidId(data.id)
        && isValidNonEmptyString(data.name, 2, 120)
        && isValidNonEmptyString(data.phone, 7, 24)
        && isValidOptionalString(data, 'email', 160)
        && isValidOptionalString(data, 'subject', 160)
        && isValidNonEmptyString(data.message, 5, 1500)
        && data.status in ['new', 'replied', 'archived'];
    }

    function isValidPaymentRecord(data) {
      return data.keys().hasAll(['id', 'bookingId', 'bookingRef', 'method', 'amountNpr', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'bookingId', 'bookingRef', 'userId', 'method', 'amountNpr', 'isAdvance', 'status', 'gatewayRef', 'verifiedByServer', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.bookingId)
        && isValidNonEmptyString(data.bookingRef, 4, 32)
        && isValidOptionalString(data, 'userId', 128)
        && data.method in ['cash', 'esewa', 'khalti', 'fonepay']
        && data.amountNpr is number && data.amountNpr >= 0 && data.amountNpr <= 500000
        && (!( 'isAdvance' in data ) || data.isAdvance is bool)
        && data.status in ['pending', 'verified', 'refunded', 'failed']
        && isValidOptionalString(data, 'gatewayRef', 128)
        && (!( 'verifiedByServer' in data ) || data.verifiedByServer is bool);
    }

    // -------------------------------------------------------------------------
    // Health Check Document
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if true;
    }

    // -------------------------------------------------------------------------
    // Admin & User Profiles
    // -------------------------------------------------------------------------
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(uid) && isValidAdminUser(incoming());
      allow delete: if isAdmin() && isValidId(uid);
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(uid) || isAdmin())
        && isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().createdAt == request.time;
      allow update: if (isOwner(uid) || isAdmin())
        && isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'preferredLanguage']);
      allow delete: if isAdmin() && isValidId(uid);
    }

    // -------------------------------------------------------------------------
    // Public Catalog & Editorial Collections (Published items public, drafts Admin)
    // -------------------------------------------------------------------------
    match /serviceCategories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(categoryId) && incoming().name is string && incoming().name.size() <= 100;
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /spaServices/{serviceId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(serviceId)
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().description is string && incoming().description.size() <= 1000
        && incoming().priceNpr is number && incoming().priceNpr >= 0;
      allow delete: if isAdmin() && isValidId(serviceId);
    }

    match /salonServices/{serviceId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(serviceId)
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().description is string && incoming().description.size() <= 1000
        && incoming().priceNpr is number && incoming().priceNpr >= 0;
      allow delete: if isAdmin() && isValidId(serviceId);
    }

    match /packages/{packageId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(packageId)
        && incoming().name is string && incoming().name.size() <= 140
        && incoming().packagePriceNpr is number && incoming().packagePriceNpr >= 0;
      allow delete: if isAdmin() && isValidId(packageId);
    }

    match /staff/{staffId} {
      allow read: if resource.data.availableForBooking == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(staffId)
        && incoming().name is string && incoming().name.size() <= 120;
      allow delete: if isAdmin() && isValidId(staffId);
    }

    match /spaRooms/{roomId} {
      allow read: if resource.data.status != 'inactive' || isAdmin();
      allow create, update: if isAdmin() && isValidId(roomId)
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().capacity is number && incoming().capacity >= 1;
      allow delete: if isAdmin() && isValidId(roomId);
    }

    match /gallery/{itemId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(itemId) && incoming().title is string && incoming().title.size() <= 140;
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /socialPosts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(postId) && incoming().title is string && incoming().title.size() <= 140;
      allow delete: if isAdmin() && isValidId(postId);
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(postId) && incoming().title is string && incoming().title.size() <= 180;
      allow delete: if isAdmin() && isValidId(postId);
    }

    match /offers/{offerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(offerId) && incoming().title is string && incoming().title.size() <= 140;
      allow delete: if isAdmin() && isValidId(offerId);
    }

    match /holidays/{holidayId} {
      allow read: if resource.data.date is string || isAdmin();
      allow create, update: if isAdmin() && isValidId(holidayId) && incoming().name is string && incoming().name.size() <= 120;
      allow delete: if isAdmin() && isValidId(holidayId);
    }

    match /settings/{settingId} {
      allow read: if settingId == 'business' || isAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && incoming().businessName is string && incoming().businessName.size() <= 140;
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // -------------------------------------------------------------------------
    // Reviews (Public Read of Published, Authenticated Create as Unpublished)
    // -------------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow get: if existing().published == true || isAdmin();
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (
            isVerifiedUser()
            && incoming().userId == request.auth.uid
            && incoming().published == false
          )
        );
      allow update: if isAdmin() && isValidId(reviewId) && isValidReview(incoming());
      allow delete: if isAdmin() && isValidId(reviewId);
    }

    // -------------------------------------------------------------------------
    // Bookings & De-Identified Booking Slots (Strict PII Isolation)
    // -------------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (
            incoming().status == 'pending'
            && incoming().paymentStatus == 'pending'
            && (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid))
          )
        )
        && existsAfter(/databases/$(database)/documents/bookingSlots/$(bookingId));
      allow update: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().id == existing().id
        && incoming().bookingRef == existing().bookingRef
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            isSignedIn()
            && existing().userId == request.auth.uid
            && incoming().userId == existing().userId
            && existing().status in ['pending', 'confirmed']
            && (
              (
                incoming().status == 'cancelled'
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              ) ||
              (
                incoming().status == existing().status
                && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'startTime', 'endTime', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    match /bookingSlots/{slotId} {
      allow read: if resource.data.date is string || isAdmin();
      allow create: if isValidId(slotId)
        && isValidBookingSlot(incoming())
        && incoming().createdAt == request.time
        && (isAdmin() || incoming().status == 'pending')
        && existsAfter(/databases/$(database)/documents/bookings/$(slotId));
      allow update: if isValidId(slotId)
        && isValidBookingSlot(incoming())
        && incoming().id == existing().id
        && incoming().bookingId == existing().bookingId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            isSignedIn()
            && get(/databases/$(database)/documents/bookings/$(slotId)).data.userId == request.auth.uid
            && existing().status in ['pending', 'confirmed']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'date', 'startTime', 'endTime'])
          )
        );
      allow delete: if isAdmin() && isValidId(slotId);
    }

    // -------------------------------------------------------------------------
    // Payments, Customers CRM, Contact Inquiries, Audit Logs
    // -------------------------------------------------------------------------
    match /payments/{paymentId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(paymentId)
        && isValidPaymentRecord(incoming())
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (
            incoming().status == 'pending'
            && (!( 'verifiedByServer' in incoming() ) || incoming().verifiedByServer == false)
            && (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid))
          )
        );
      allow update: if isAdmin() && isValidId(paymentId) && isValidPaymentRecord(incoming());
      allow delete: if isAdmin() && isValidId(paymentId);
    }

    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidId(customerId)
        && incoming().fullName is string && incoming().fullName.size() <= 120
        && incoming().phone is string && incoming().phone.size() <= 24;
      allow delete: if isAdmin() && isValidId(customerId);
    }

    match /contactMessages/{messageId} {
      allow read: if isAdmin();
      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming())
        && incoming().createdAt == request.time
        && (isAdmin() || incoming().status == 'new');
      allow update: if isAdmin() && isValidId(messageId) && isValidContactMessage(incoming());
      allow delete: if isAdmin() && isValidId(messageId);
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && incoming().action is string && incoming().action.size() <= 120;
      allow update, delete: if false;
    }
  }
}
