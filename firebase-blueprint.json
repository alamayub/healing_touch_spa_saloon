        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "durationMinutes": { "type": "number" },
        "bufferMinutes": { "type": "number" },
        "totalNpr": { "type": "number" },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 7, "maxLength": 24 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "preferredLanguage": { "type": "string", "enum": ["en", "ne"] },
        "notes": { "type": "string", "maxLength": 600 },
        "comfortPreferences": { "type": "string", "maxLength": 400 },
        "consentAccepted": { "type": "boolean" },
        "agePolicyConfirmed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled", "rejected", "no_show"] },
        "paymentMethod": { "type": "string", "enum": ["cash", "esewa", "khalti", "fonepay"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "advance_paid", "paid", "refunded", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
