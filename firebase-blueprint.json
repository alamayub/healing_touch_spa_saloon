        "serviceNames": { "type": "array" },
        "isCouple": { "type": "boolean" },
        "guestCount": { "type": "number" },
        "staffId": { "type": "string", "maxLength": 128 },
        "staffName": { "type": "string", "maxLength": 120 },
        "roomId": { "type": "string", "maxLength": 128 },
