    "Booking": {
      "title": "Booking",
      "description": "Spa, salon, or package appointment reservation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingRef": { "type": "string", "maxLength": 32 },
        "userId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["spa", "salon", "package"] },
